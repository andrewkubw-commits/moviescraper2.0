# Copy to .env and fill in. Never commit .env.

# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...   # service_role key (server-side only, bypasses RLS)

# Public edge function that resolves fresh signed URLs on demand (not a secret)
GET_MEDIA_URL=https://tzxoptjhttlwjajyahyy.supabase.co/functions/v1/get-media

# Scraper tuning (optional)
VIDEO_BATCH=250        # movies resolved per run (episodes phase)
CONCURRENCY=4          # parallel requests
REQUEST_TIMEOUT=30000  # ms
MAX_RETRIES=4
RETRY_BASE_MS=800
SKIP_LOCKED=false      # "locked" is client-side only; real sources are public. Set true to ignore locked titles.
